thenticate":false,"template":"<span>{{ item.label }}</span>","multiple":false,"protected":false,"unique":false,"labelPosition":"none","persistent":true,"selectedResource":{"id":"","text":""},"validate":{"required":false},"disabledByContainer":false,"type":"select","hasError":false,"hasErrorInName":false,"emptyResourse":true,"hideLabel":true,"tags":[],"conditional":{"show":"","when":null,"eq":""},"conditionalDisable":{"disable":"","when":null,"eq":""},"lockKey":true}],"tableView":true,"label":"تولید","key":"DG4","protected":false,"persistent":true,"autoNumber":true,"disabledByContainer":false,"type":"datagrid","DisableTableName":false,"maximumDataGridTableNameLength":26,"disablesSaveBtn":false,"dbTableName":"tmp45_DG4","hasError":false,"hasErrorInName":false,"emptyResourse":false,"tags":[],"conditional":{"show":"","when":null,"eq":""},"conditionalDisable":{"disable":"","when":null,"eq":""},"lockKey":true,"striped":false,"bordered":true}],"disabledByContainer":false}],"disabledByContainer":false,"type":"columns","hasError":false,"hasErrorInName":false,"emptyResourse":false,"tags":[],"conditional":{"show":"","when":null,"eq":""},"conditionalDisable":{"disable":"","when":null,"eq":""}}],"disabledByContainer":false,"titleClass":"up-title","titleDirection":"Up","panelHeadingWidth":null,"panelHeadingHeight":null,"type":"panel","hasError":false,"hasErrorInName":false,"emptyResourse":false,"tags":[],"conditional":{"show":"","when":null,"eq":""},"conditionalDisable":{"disable":"","when":null,"eq":""}},{"key":"panel6","input":false,"title":"مهندسی فروش","theme":"primary","components":[{"input":true,"label":"ایجاد پیش فاکتور","tableView":false,"key":"evaluate4","size":"md","leftIcon":"","rightIcon":"","block":false,"disableOnInvalid":false,"theme":"primary","disabledByContainer":false,"type":"fonixbutton","hasError":false,"hasErrorInName":false,"emptyResourse":false,"panelHeadingHeight":null,"tags":[],"conditional":{"show":"","when":null,"eq":""},"conditionalDisable":{"disable":"","when":null,"eq":""},"codeEditorValue":"var data = $scope.data;\r\n\r\nvar source = data.DG2 || [];\r\nvar grid3 = data.DG3 || [];\r\nvar grid4 = data.DG4 || [];\r\n\r\nif (source.length === 0) {\r\n    alert(\"دیتاگرید DG2 خالی است.\");\r\n    return;\r\n}\r\n\r\n// -------------------------------------------\r\n// استانداردسازی کد محصول\r\n// -------------------------------------------\r\nfunction getKey(value) {\r\n    if (value === null || value === undefined) {\r\n        return \"\";\r\n    }\r\n    return String(value).trim();\r\n}\r\n\r\n// -------------------------------------------\r\n// ساخت فهرست کدهای ردشده\r\n// -------------------------------------------\r\nvar rejectedCodes = Object.create(null);\r\n\r\ngrid3.forEach(function(row) {\r\n    var code = getKey(row.Productcodee3);\r\n\r\n    if (\r\n        code !== \"\" &&\r\n        row.Selectedfieldstatuss3 === \"عدم امکان تولید\"\r\n    ) {\r\n        rejectedCodes[code] = true;\r\n    }\r\n});\r\n\r\ngrid4.forEach(function(row) {\r\n    var code = getKey(row.Productcodee4);\r\n\r\n    if (\r\n        code !== \"\" &&\r\n        row.Selectedfieldstatuss4 === \"عدم امکان تولید\"\r\n    ) {\r\n        rejectedCodes[code] = true;\r\n    }\r\n});\r\n\r\n// -------------------------------------------\r\n// بررسی اولیه کدهای خالی\r\n// -------------------------------------------\r\nvar emptyCodes = [];\r\n\r\nsource.forEach(function(row, index) {\r\n    if (getKey(row.Productcodee2) === \"\") {\r\n        emptyCodes.push(index + 1);\r\n    }\r\n});\r\n\r\nif (emptyCodes.length > 0) {\r\n    alert(\r\n        \"کد محصول در ردیف‌های زیر خالی است:\\n\" +\r\n        emptyCodes.join(\", \") +\r\n        \"\\nلطفاً اطلاعات DG2 را اصلاح کنید.\"\r\n    );\r\n    return;\r\n}\r\n\r\n// -------------------------------------------\r\n// بررسی کدهای تکراری در DG2\r\n// -------------------------------------------\r\nvar seen = Object.create(null);\r\nvar duplicates = [];\r\n\r\nsource.forEach(function(row) {\r\n    var code = getKey(row.Productcodee2);\r\n\r\n    if (seen[code]) {\r\n        if (duplicates.indexOf(code) === -1) {\r\n            duplicates.push(code);\r\n        }\r\n    }\r\n\r\n    seen[code] = true;\r\n});\r\n\r\nif (duplicates.length > 0) {\r\n    alert(\r\n        \"کدهای محصول تکراری در DG2:\\n\" +\r\n        duplicates.join(\", \") +\r\n        \"\\nلطفاً پیش از ادغام بررسی کنید.\"\r\n    );\r\n    return;\r\n}\r\n\r\n// -------------------------------------------\r\n// محاسبه خروجی‌های نهایی\r\n// -------------------------------------------\r\nvar resultDG5 = [];\r\nvar resultDG6 = [];\r\n\r\nsource.forEach(function(row) {\r\n\r\n    var code = getKey(row.Productcodee2);\r\n\r\n    if (rejectedCodes[code] === true) {\r\n\r\n        resultDG6.push({\r\n            Productdescription6: row.Productdescription2,\r\n            Brand6: row.Brand2,\r\n            Productcodee6: row.Productcodee2\r\n        });\r\n\r\n    } else {\r\n\r\n        resultDG5.push({\r\n            Productdescription5: row.Productdescription2,\r\n            Brand5: row.Brand2,\r\n            Productcodee5: row.Productcodee2\r\n        });\r\n\r\n    }\r\n});\r\n\r\n// -------------------------------------------\r\n// ثبت خروجی‌ها\r\n// -------------------------------------------\r\nif (!Array.isArray(data.DG5)) {\r\n    data.DG5 = [];\r\n}\r\n\r\nif (!Array.isArray(data.DG6)) {\r\n    data.DG6 = [];\r\n}\r\n\r\ndata.DG5.splice.apply(\r\n    data.DG5,\r\n    [0, data.DG5.length].concat(resultDG5)\r\n);\r\n\r\ndata.DG6.splice.apply(\r\n    data.DG6,\r\n    [0, data.DG6.length].concat(resultDG6)\r\n);\r\n\r\n// -------------------------------------------\r\n// گزارش نتیجه\r\n// -------------------------------------------\r\nalert(\r\n    \"عملیات ادغام با موفقیت انجام شد.\\n\" +\r\n    \"تعداد کل کالاها: \" + source.length + \"\\n\" +\r\n    \"انتقال به DG5: \" + resultDG5.length + \"\\n\" +\r\n    \"انتقال به DG6: \" + resultDG6.length\r\n);"},{"key":"panel7","input":false,"title":"امکان تولید","theme":"primary","components":[{"input":true,"tree":true,"components":[{"input":true,"tableView":true,"inputType":"text","inputMask":"","valueContainsMask":false,"label":"نام کالا","key":"Productdescription5","placeholder":"","labelPosition":"none","prefix":"","suffix":"","multiple":false,"defaultValue":"","protected":false,"unique":false,"persistent":true,"validate":{"required":false,"minLength":"","maxLength":"","pattern":"","custom":"","customPrivate":false},"conditional":{"show":"","when":null,"eq":""},"disabledByContainer":false,"type":"textfield","hasError":false,"hasErrorInName":false,"emptyResourse":false,"hideLabel":true,"ssoClaims":[],"tags":[],"conditionalDisable":{"disable":"","when":null,"eq":""},"lockKey":true},{"input":true,"tableView":true,"inputType":"text","inputMask":"","valueContainsMask":false,"label":"Brand","key":"Brand5","placeholder":"","labelPosition":"none","prefix":"","suffix":"","multiple":false,"defaultValue":"","protected":false,"unique":false,"persistent":true,"validate":{"required":false,"minLength":"","maxLength":"","pattern":"","custom":"","customPrivate":false},"conditional":{"show":"","when":null,"eq":""},"disabledByContainer":false,"type":"textfield","hasError":false,"hasErrorInName":false,"emptyResourse":false,"hideLabel":true,"ssoClaims":[],"tags":[],"conditionalDisable":{"disable":"","when":null,"eq":""},"lockKey":true},{"input":true,"tableView":true,"inputType":"text","inputMask":"","valueContainsMask":false,"label":"کد محصول","key":"Productcodee5","placeholder":"","labelPosition":"none","prefix":"","suffix":"","multiple":false,"defaultValue":"","protected":false,"unique":false,"persistent":true,"validate":{"required":false,"minLength":"","maxLength":"","pattern":"","custom":"","customPrivate":false},"conditional":{"show":"","when":null,"eq":""},"disabledByContainer":false,"type":"textfield","hasError":false,"hasErrorInName":false,"emptyResourse":false,"hideLabel":true,"ssoClaims":[],"tags":[],"conditionalDisa